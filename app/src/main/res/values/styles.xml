<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--  BOTTOM NAVIGATION  -->
    <!-- Usado en: app_bar_main.xml -->
    <style name="BottomNavigationView.Clean" parent="Widget.Design.BottomNavigationView">
        <!-- Fondo blanco puro -->
        <item name="android:background">@android:color/white</item>
        <item name="backgroundTint">@android:color/white</item>
        
        <!-- Elevación y sombra -->
        <item name="android:elevation">8dp</item>
        <item name="elevation">8dp</item>
        
        <!-- Colores de iconos y texto -->
        <item name="itemIconTint">@color/bottom_nav_icon_color_modern</item>
        <item name="itemTextColor">@color/bottom_nav_text_color_modern</item>
        
        <!-- Fondo de items transparente -->
        <item name="itemBackground">@android:color/transparent</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        
        <!-- Configuración de indicadores y texto -->
        <item name="itemActiveIndicatorStyle">@style/BottomNavigationView.CleanIndicator</item>
        <item name="itemTextAppearanceActive">@style/BottomNavigationView.TextAppearance.Active</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationView.TextAppearance.Inactive</item>
        
        <!-- Visibilidad y tamaños -->
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">28dp</item>
        
        <!-- Theme overlay -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.BottomNav.Clean</item>
    </style>

    <!-- Indicador invisible para diseño limpio -->
    <style name="BottomNavigationView.CleanIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
    </style>

    <!-- Texto activo del bottom navigation -->
    <style name="BottomNavigationView.TextAppearance.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/aquanqa_blue_light</item>
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Texto inactivo del bottom navigation -->
    <style name="BottomNavigationView.TextAppearance.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">@font/montserrat</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Theme Overlay para fondo blanco -->
    <style name="ThemeOverlay.BottomNav.Clean" parent="">
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorSecondary">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorSurfaceVariant">@android:color/white</item>
        <item name="colorSurfaceContainer">@android:color/white</item>
    </style>

    <!-- ========== ESTILOS DE PERFIL ========== -->
    <!-- Usado en: fragment_profile.xml, fragment_edit_profile.xml -->
    <style name="ProfileDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:alpha">0.6</item>
    </style>

    <!-- ========== ESTILOS DE BOTONES ========== -->
    <!-- Usado en: fragment_notifications.xml -->
    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/aquanqa_blue</item>
        <item name="android:textColor">@color/aquanqa_blue</item>
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="cornerRadius">8dp</item>
    </style>

</resources> 