<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Estado presionado -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/aquanqa_green" />
            <stroke 
                android:width="2dp" 
                android:color="@color/border_light" />
        </shape>
    </item>
    
    <!-- Estado normal -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/aquanqa_blue" />
            <stroke 
                android:width="1dp" 
                android:color="@color/aquanqa_blue" />
        </shape>
    </item>
    
</selector>