<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Estado presionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aquanqa_blue_dark" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/border_medium" />
        </shape>
    </item>
    
    <!-- Estado deshabilitado -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_secondary" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/border_light" />
        </shape>
    </item>
    
    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aquanqa_blue" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
</selector>