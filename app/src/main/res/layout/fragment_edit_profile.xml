<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true"
    tools:context=".ui.profile.EditProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"

        >

        <!-- Header Card con información principal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"

            app:cardBackgroundColor="@color/background_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"

                android:background="@color/white"
                android:padding="32dp">

                <!-- Foto de perfil con botón de edición -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileImageView"
                        android:layout_width="115dp"
                        android:layout_height="115dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView"
                        app:contentPadding="6dp"
                        app:strokeWidth="3dp"

                        tools:src="@drawable/ic_profile" />

                    <!-- Botón de edición de foto -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/changePhotoButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:contentDescription="Cambiar foto de perfil"
                        app:elevation="6dp"
                        app:fabCustomSize="44dp"
                        app:fabSize="auto"
                        app:maxImageSize="20dp"
                        app:backgroundTint="@color/aquanqa_blue"
                        app:tint="@color/white"
                        app:srcCompat="@android:drawable/ic_menu_camera"
                        app:borderWidth="0dp" />

                </FrameLayout>

                <!-- Información principal -->
                <TextView
                    android:id="@+id/nameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textSize="24sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    tools:text="Carlos García Pérez" />

                <TextView
                    android:id="@+id/roleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/montserrat_medium"
                    android:gravity="center"
                    tools:text="Desarrollador Senior" />

                <!-- Badge de edición -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Editando perfil"
                    android:textColor="@color/aquanqa_blue"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/background_secondary"
                    app:chipStrokeColor="@color/aquanqa_blue"
                    app:chipStrokeWidth="1dp"
                    app:chipCornerRadius="12dp"
                    app:chipMinHeight="24dp"
                    app:chipIcon="@drawable/ic_edit"
                    app:chipIconTint="@color/aquanqa_blue" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card de información editable -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/background_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <!-- Título de la sección -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:text="INFORMACIÓN EDITABLE"
                    android:textSize="12sp"
                    android:textColor="@color/aquanqa_blue"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.1" />

                <!-- Email Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMAIL"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/montserrat_medium"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingresa tu email"
                        app:boxStrokeColor="@color/border_focus"
                        app:hintTextColor="@color/text_hint"
                        app:boxBackgroundColor="@color/background_input"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/aquanqa_blue"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/montserrat"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <View style="@style/ProfileDivider" />

                <!-- Password Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NUEVA CONTRASEÑA"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/montserrat_medium"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Toca para cambiar contraseña"
                        app:boxStrokeColor="@color/border_focus"
                        app:hintTextColor="@color/text_hint"
                        app:boxBackgroundColor="@color/background_input"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:startIconDrawable="@drawable/ic_lock_outline"
                        app:startIconTint="@color/aquanqa_blue"
                        app:endIconDrawable="@drawable/ic_edit"
                        app:endIconTint="@color/text_hint"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="@font/montserrat"
                            android:maxLines="1"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card de firma digital -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/background_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:padding="20dp">

                <!-- Título de la sección -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="FIRMA DIGITAL"
                    android:textSize="12sp"
                    android:textColor="@color/aquanqa_blue"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.1" />

                <!-- Contenedor de firma mejorado -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/background_secondary"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/border_light"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <ImageView
                                android:id="@+id/signatureImageView"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:adjustViewBounds="true"
                                android:scaleType="centerInside"
                                tools:src="@tools:sample/backgrounds/scenic" />

                            <View
                                android:layout_width="120dp"
                                android:layout_height="1dp"
                                android:background="@color/text_hint"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Firma digitalizada"
                                android:textSize="11sp"
                                android:textColor="@color/text_hint"
                                android:fontFamily="@font/montserrat"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Botón de edición de firma -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/changeSignatureButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:contentDescription="Cambiar firma"
                            app:elevation="6dp"
                            app:fabCustomSize="44dp"
                            app:fabSize="auto"
                            app:maxImageSize="20dp"
                            app:backgroundTint="@color/aquanqa_blue"
                            app:tint="@color/white"
                            app:srcCompat="@android:drawable/ic_menu_edit"
                            app:borderWidth="0dp" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de acción mejorados -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="20dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_secondary"
                app:strokeColor="@color/text_secondary"
                app:strokeWidth="2dp"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/aquanqa_blue"
                android:text="Guardar Cambios"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="@font/montserrat_bold"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

        <!-- ProgressBar para indicar carga -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>