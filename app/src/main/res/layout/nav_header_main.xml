<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:fitsSystemWindows="true"
    >

    <!-- Fondo con gradiente azul corporativo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo_blue"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo de Aquanqa en la esquina superior derecha -->
    <ImageView
        android:id="@+id/nav_header_logo"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.8"
        android:src="@drawable/logo_aq"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor principal centrado verticalmente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Imagen de perfil con sombra y borde -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/nav_header_profile_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:elevation="8dp"
            android:padding="5dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView"
            app:srcCompat="@drawable/ic_profile"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />

        <!-- Nombre del usuario -->
        <TextView
            android:id="@+id/nav_header_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Nombre de Usuario"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#40000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Email del usuario -->
        <TextView
            android:id="@+id/nav_header_user_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="usuario@example.com"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:alpha="0.9"
            android:shadowColor="#40000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Línea decorativa -->
        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="@color/white"
            android:alpha="0.7" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 