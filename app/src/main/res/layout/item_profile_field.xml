<?xml version="1.0" encoding="utf-8"?>
<!-- Componente reutilizable para campos del perfil -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp"
    android:gravity="center_vertical">

    <!-- Icono del campo (opcional) -->
    <ImageView
        android:id="@+id/fieldIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:tint="@color/aquanqa_blue"
        tools:src="@drawable/ic_person_outline"
        tools:visibility="visible" />

    <!-- Contenedor de texto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Label del campo -->
        <TextView
            android:id="@+id/fieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_medium"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:textAllCaps="true"
            tools:text="NOMBRES COMPLETOS" />

        <!-- Valor del campo -->
        <TextView
            android:id="@+id/fieldValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Carlos García Pérez" />

    </LinearLayout>



</LinearLayout>