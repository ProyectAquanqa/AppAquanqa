<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- Header Container con foto de perfil, nombre y fecha -->
        <LinearLayout
            android:id="@+id/ll_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Foto de perfil del autor -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_author_photo"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImageView"
                tools:src="@tools:sample/avatars" />

            <!-- Container de nombre y fecha -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- Nombre del autor -->
                <TextView
                    android:id="@+id/tv_author_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Sofia Rivera"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Fecha de publicación -->
                <TextView
                    android:id="@+id/tv_publish_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/montserrat"
                    android:text="Publicado: 10 de mayo"
                    android:textColor="#888888"
                    android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/pinned"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_pinned"
                android:adjustViewBounds="true"
                android:scaleType="centerInside"
                />


        </LinearLayout>

        <!-- Contenido del post -->
        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_header">

            <!-- Título del anuncio -->
            <TextView
                android:id="@+id/tv_announcement_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="Nuevo evento de networking"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="1dp" />

            <!-- Descripción del anuncio -->
            <TextView
                android:id="@+id/tv_announcement_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/montserrat"
                android:text="El evento de networking de este mes se llevará a cabo en el centro de la ciudad. Habrá oportunidades para conocer a otros profesionales y expandir tu red de contactos. ¡No te lo pierdas!"
                android:textColor="#444444"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Imagen del anuncio - CLICK PARA VER EN GRANDE -->
        <ImageView
            android:id="@+id/iv_announcement_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/image_event"
            android:maxHeight="400dp"
            android:minHeight="120dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_content"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Barra de acciones -->
        <LinearLayout
            android:id="@+id/ll_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@id/iv_announcement_image"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_like"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:contentDescription="@string/like"
                android:paddingHorizontal="5dp"
                app:icon="@drawable/ic_like_outline"
                app:iconTint="@color/text_secondary"
                app:iconSize="35dp"
                android:backgroundTint="@android:color/transparent"
                app:rippleColor="#1A000000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_comment"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:contentDescription="@string/comment"
                android:paddingHorizontal="5dp"
                app:icon="@drawable/ic_comment"
                app:iconTint="@color/text_secondary"
                app:iconSize="30dp"
                android:backgroundTint="@android:color/transparent"
                app:rippleColor="#1A000000" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:minWidth="0dp"

                android:contentDescription="@string/share"
                android:paddingHorizontal="5dp"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/text_secondary"
                app:iconSize="35dp"
                android:backgroundTint="@android:color/transparent"
                app:rippleColor="#1A000000" />

        </LinearLayout>

        <!-- Línea divisoria al final -->
        <View
            android:id="@+id/bottom_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E5E5E5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_actions"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

 
</com.google.android.material.card.MaterialCardView>